        "    \"diff_srv_rate\"\n",
        "]\n",
        "\n",
        "for feature in features_to_plot:\n",
        "\n",
        "    plt.figure(figsize=(7, 4))\n",
        "\n",
        "    plt.hist(\n",
        "        train_df[train_df[\"binary_label\"] == 0][feature],\n",
        "        bins=50,\n",
        "        alpha=0.6,\n",
        "        label=\"Normal\"\n",
        "    )\n",
        "\n",
        "    plt.hist(\n",
        "        train_df[train_df[\"binary_label\"] == 1][feature],\n",

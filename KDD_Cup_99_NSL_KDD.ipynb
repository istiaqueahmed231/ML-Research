        "        label=\"Attack\"\n",
        "    )\n",
        "\n",
        "    plt.xlabel(feature)\n",
        "    plt.ylabel(\"Frequency\")\n",
        "    plt.title(f\"{feature}: Normal vs Attack\")\n",
        "    plt.legend()\n",
        "\n",
        "    plt.show()"
